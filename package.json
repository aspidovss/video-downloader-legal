{
  "name": "video-downloader-legal",
  "version": "1.6.4",
  "private": true,
  "type": "module",
  "description": "Firefox and Chrome extension: detect and download videos (direct files, HLS, DASH). No DRM circumvention.",
  "author": "AspidovSS",
  "license": "MIT",
  "scripts": {
    "test": "node --test --test-force-exit tests/*.test.js",
    "lint": "web-ext lint --source-dir . --ignore-files tests package.json package-lock.json node_modules README.md",
    "build:chrome": "node scripts/build-chrome.mjs --zip",
    "build:edge": "node scripts/build-chrome.mjs --zip --edge",
    "build:chrome-updater": "node scripts/build-chrome.mjs --zip --updater",
    "build-lamejs": "node scripts/build-lamejs.mjs",
    "verify-lamejs": "node scripts/build-lamejs.mjs --compare",
    "run": "web-ext run --source-dir . --ignore-files tests package.json",
    "build": "node scripts/build-ff.mjs",
    "build:dev": "node scripts/build-ff.mjs --dev",
    "build:amo-dev": "node scripts/build-amo-dev.mjs",
    "build:amo": "node scripts/build-amo-dev.mjs --release",
    "build-for-amo": "node scripts/build-ff.mjs"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  }
}
